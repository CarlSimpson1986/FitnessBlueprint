# ─────────────────────────────────────────────────────────────
# Fitness Blueprint — environment variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
#
# Variables prefixed NEXT_PUBLIC_ are sent to the browser.
# Only put values here that are safe for a member to see in
# devtools. Everything else stays server-only.
# ─────────────────────────────────────────────────────────────

# --- Supabase ---------------------------------------------------
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE KEY — bypasses Row Level Security entirely.
# Server-only. Never prefix with NEXT_PUBLIC_. Never import the
# admin client (src/lib/supabase/admin.ts) into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (card payments, GCP + general memberships) ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or Dashboard webhook endpoint config
STRIPE_WEBHOOK_SECRET=

# --- Stripe Connect (Kids programme — separate bank account) ----
# Connected account ID once Kids payments are set up (v2)
STRIPE_KIDS_CONNECTED_ACCOUNT_ID=

# --- GoCardless (UK direct debit) --------------------------------
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# --- Coach Ted (Gemini Flash + PubMed) ---------------------------
GEMINI_API_KEY=
# Free NCBI API key raises the PubMed rate limit from 3 to 10 req/sec
# https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=

# --- Email (Brevo) ------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@fitnessblueprint.co.uk

# --- Push notifications (Firebase Cloud Messaging) ----------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
